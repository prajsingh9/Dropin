# ─── Supabase ────────────────────────────────────────────────────────────────
# Leave these empty to run Dropin in local demo mode (data lives in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes for hardware ingestion and validated writes.
# NEVER prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Hardware simulator ──────────────────────────────────────────────────────
# The developer simulation panel is on in `next dev` and in local demo mode.
# With Supabase configured, production builds hide it unless this is "true" (staging only).
NEXT_PUBLIC_ENABLE_SIMULATOR=

# ─── Web push (optional) ─────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ─── Support (optional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=
